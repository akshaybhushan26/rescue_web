{
  "name": "trelium-order-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:lab-browser": "node tests/lab-browser.mjs",
    "format": "prettier --write src tests README.md DEMO.md package.json tsconfig.json next.config.ts",
    "format:check": "prettier --check src tests README.md DEMO.md package.json tsconfig.json next.config.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "playwright": "^1.58.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
